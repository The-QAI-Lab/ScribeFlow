inbox/mp3/*
!inbox/mp3/.gitkeep
inbox/mp4/*
!inbox/mp4/.gitkeep
working/audio/*
!working/audio/.gitkeep
working/temp/*
!working/temp/.gitkeep
working/logs/*
!working/logs/.gitkeep
output/markdown/*
!output/markdown/.gitkeep
output/raw_json/*
!output/raw_json/.gitkeep
output/subtitles/*
!output/subtitles/.gitkeep
archive/completed/*
!archive/completed/.gitkeep
archive/failed/*
